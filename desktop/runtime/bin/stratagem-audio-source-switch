#!/bin/bash

# stratagem:summary=Cycle to the next media source and transfer playback when the current source is playing
# stratagem:args=[next|previous]
# stratagem:examples=stratagem audio source switch | stratagem-audio-source-switch previous

direction="${1:-next}"

case "$direction" in
  next)
    stratagem-shell media sourceSwitch
    ;;
  previous)
    stratagem-shell media sourceSwitchPrevious
    ;;
  *)
    echo "Usage: stratagem-audio-source-switch [next|previous]" >&2
    exit 1
    ;;
esac
