#!/bin/bash

# stratagem:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  stratagem-brightness-keyboard-mute on
  stratagem-osd -i microphone-muted -m "Microphone muted"
else
  stratagem-brightness-keyboard-mute off
  stratagem-osd -i microphone -m "Microphone on"
fi
