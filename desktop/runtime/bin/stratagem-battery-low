#!/bin/bash

# stratagem:summary=Send the low battery warning notification and run battery-low hooks.
# stratagem:args=<percentage>
# stratagem:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: stratagem-battery-low <percentage>" >&2
  exit 1
fi

level=$1

stratagem-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
stratagem-hook battery-low "$level"
